# Copy to .env to override. Every value below is the built-in default.
PORT=31544
LA_DATA_ROOT=./data
# How many AI sessions the app will have in flight at once. Not a permission — just a
# ceiling on how hard the provider is hit when a course fans out its writing sessions.
LA_SESSION_CONCURRENCY=2

# --- Docker only ---------------------------------------------------------------
# Ignored by start.sh and start.bat; read by docker-compose.yml. See README,
# "Setup and run" > "With Docker".
#
# Where ./data is mounted from. Point it elsewhere to keep courses outside the repo.
# LA_DATA_DIR=./data
#
# The uid/gid the container runs as. 1000 is `node` in the image and the first account
# on a stock linux desktop, so this is usually right already. Docker Desktop on Windows
# and macOS ignores ownership on bind mounts — leave these alone there. On linux, if the
# container says it cannot write to /app/data, set these to your `id -u` and `id -g`.
# LA_UID=1000
# LA_GID=1000
#
# Build the claude CLI into the image. OFF by default, and read the README section before
# turning it on: an unauthenticated CLI answers `claude --version` happily, so the app's
# provider check would call it healthy while every lesson it tries to write fails.
# LA_INSTALL_CLAUDE_CLI=false
#
# The host directory mounted at the container's ~/.claude. The default is a docker-managed
# empty volume. Set it to your own ~/.claude to share the credential the CLI already holds
# (linux and Windows hosts; on macOS that credential is in the Keychain, not in a file).
# LA_CLAUDE_HOME=/home/you/.claude
#
# A provider "on 127.0.0.1" is the container's own loopback, where nothing is listening.
# Inside a container these default to host.docker.internal instead — the machine running
# docker. Ollama must also be listening on more than loopback: OLLAMA_HOST=0.0.0.0.
# LA_OLLAMA_URL=http://host.docker.internal:11434

# Which AI writes the lessons. One of:
#   claude             the Claude CLI on your PATH (default; needs `claude` installed and signed in)
#   ollama             a model served locally by Ollama
#   llama              a model served locally by llama.cpp's llama-server
#   anthropic          the Anthropic API directly, with your own key
#   openai             the OpenAI API
#   openai-compatible  anything speaking OpenAI's /chat/completions — LM Studio, vLLM,
#                      llama.cpp's server, OpenRouter, Groq, Together, DeepSeek, and most
#                      of the rest. Set the base URL below to whichever one you run.
#   gemini             Google Gemini
#   mistral            Mistral
LA_PROVIDER=claude

# --- API keys -----------------------------------------------------------------
# Read from the environment (this file included) and nowhere else: a key is never written
# to config.json, never stored in the database, and never logged. Each provider also
# accepts the vendor's own conventional variable as a fallback, so a machine already set
# up for that vendor needs no second copy of the same secret. The LA_ name wins when both
# are set. Only the selected provider's key is ever read.
# LA_ANTHROPIC_KEY=          # or ANTHROPIC_API_KEY
# LA_OPENAI_KEY=             # or OPENAI_API_KEY
# LA_OPENAI_COMPAT_KEY=      # often unset — a server on this machine usually wants no key
# LA_GEMINI_KEY=             # or GEMINI_API_KEY / GOOGLE_API_KEY
# LA_MISTRAL_KEY=            # or MISTRAL_API_KEY

# --- Where each provider lives, and which model it runs ------------------------
# Same three variables per provider, spelled from one prefix. Everything here is also
# editable in Settings; the environment wins at startup.
LA_CLAUDE_BIN=claude
# LA_CLAUDE_MODEL=

LA_OLLAMA_URL=http://127.0.0.1:11434
LA_OLLAMA_MODEL=llama3.1

LA_LLAMA_URL=http://127.0.0.1:18080
LA_LLAMA_BIN=llama-server
# LA_LLAMA_MODEL=            # path to a .gguf file; llama.cpp cannot start without one

LA_ANTHROPIC_URL=https://api.anthropic.com
LA_ANTHROPIC_MODEL=claude-opus-5

LA_OPENAI_URL=https://api.openai.com/v1
LA_OPENAI_MODEL=gpt-4o

LA_OPENAI_COMPAT_URL=http://127.0.0.1:1234/v1
# LA_OPENAI_COMPAT_MODEL=    # whatever id your server reports; there is no sensible default

LA_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta
LA_GEMINI_MODEL=gemini-2.5-flash

LA_MISTRAL_URL=https://api.mistral.ai/v1
LA_MISTRAL_MODEL=mistral-large-latest

# --- A second, smaller model for conversation ----------------------------------
# Writing a lesson runs ahead of you and is judged on quality; answering you in a lesson
# has you waiting on it. Set a chat model to send the conversation somewhere faster.
# Empty means one model does both jobs. Same provider either way — this picks the model,
# not the machine.
# LA_CHAT_CLAUDE_MODEL=
# LA_CHAT_OLLAMA_MODEL=
# LA_CHAT_LLAMA_MODEL=       # a second llama-server, started the same way as the first
# LA_CHAT_LLAMA_URL=http://127.0.0.1:18081
# LA_CHAT_ANTHROPIC_MODEL=
# LA_CHAT_OPENAI_MODEL=
# LA_CHAT_OPENAI_COMPAT_MODEL=
# LA_CHAT_GEMINI_MODEL=
# LA_CHAT_MISTRAL_MODEL=
